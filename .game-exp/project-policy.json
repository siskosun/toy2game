{
  "schema_version": 2,
  "adapter": "node-npm",
  "toolchain": {
    "node_version": "22.21.1"
  },
  "install": {
    "argv": [
      "npm",
      "ci"
    ]
  },
  "test": {
    "argv": [
      "npm",
      "test"
    ]
  },
  "build": {
    "argv": [
      "npm",
      "run",
      "build"
    ]
  },
  "candidate": {
    "include": [
      "dist"
    ],
    "required_paths": [
      "dist/index.html",
      "dist/games"
    ]
  }
}
